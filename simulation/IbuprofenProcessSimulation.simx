    </Model>
    <Model>
      <Type>Product</Type>
      <Description>Default replaceable product model to mark models as final products for environmental and economics related calculations.
This submodel extends other models. While holding SHIFT, drag it on top of an existing model in your simulation.
To customize it make a copy in your simulation library.</Description>
      <IsReplaceableModel />
      <Parameters>
        <Parameter>
          <Name>FluidType</Name>
          <Description>Product fluid type</Description>
          <Type>FluidType</Type>
          <UplevelReference />
        </Parameter>
      </Parameters>
      <Conditions>
        <Condition>
          <Name>Dyn</Name>
          <Expression>Mode = Dynamics</Expression>
        </Condition>
      </Conditions>
      <Connections>
        <Connection>
          <Name>Conn1</Name>
          <Type>Variable</Type>
          <From>W</From>
          <To>ProductW</To>
        </Connection>
      </Connections>
      <Variables>
        <Variable>
          <Name>W</Name>
          <Description>Product mass flow rate from parent model</Description>
          <Type>Mass Flow</Type>
          <ProcessMode Lock="Always">false</ProcessMode>
          <FluidFlowMode Lock="Always">false</FluidFlowMode>
          <DynamicMode Lock="Always">false</DynamicMode>
          <UplevelReference />
        </Variable>
        <Variable>
          <Name>Q</Name>
          <Description>Product volumetric flow rate from parent model</Description>
          <Type>Vol Flow</Type>
          <ProcessMode Lock="Always">false</ProcessMode>
          <FluidFlowMode Lock="Always">false</FluidFlowMode>
          <DynamicMode Lock="Always">false</DynamicMode>
          <UplevelReference />
        </Variable>
        <Variable>
          <Name>ValuePerMass</Name>
          <Description>Product value per unit mass of material</Description>
          <Type>Currency / Mass</Type>
          <Group>Economics</Group>
          <ProcessMode />
          <FluidFlowMode />
          <DynamicMode />
          <Favorite />
        </Variable>
        <Variable>
          <Name>ValuePerVol</Name>
          <Description>Product value per unit volume of material</Description>
          <Type>Currency / Volume</Type>
          <Group>Economics</Group>
          <Favorite />
        </Variable>
        <Variable>
          <Name>ProductValue</Name>
          <Description>Product overall value of product per time</Description>
          <Type>Currency / Time</Type>
          <Group>Economics</Group>
          <Favorite />
          <TotalizedVariable />
        </Variable>
        <Variable>
          <Name>ProductW</Name>
          <Description>Product mass flow rate from parent model</Description>
          <Type>Mass Flow</Type>
          <ProcessMode Lock="Always">false</ProcessMode>
          <FluidFlowMode Lock="Always">false</FluidFlowMode>
          <DynamicMode Lock="Always">false</DynamicMode>
          <TotalizedVariable />
        </Variable>
        <Variable>
          <Name>F</Name>
          <Description>Product molar flow from parent model</Description>
          <Type>Mole Flow</Type>
          <ProcessMode Lock="Always">false</ProcessMode>
          <FluidFlowMode Lock="Always">false</FluidFlowMode>
          <DynamicMode Lock="Always">false</DynamicMode>
          <UplevelReference />
        </Variable>
        <Variable>
          <Name>z</Name>
          <Description>Product molar composition from parent model</Description>
          <Type>Molar Composition</Type>
          <Dimension>FluidType.CompList</Dimension>
          <ProcessMode Lock="Always">false</ProcessMode>
          <FluidFlowMode Lock="Always">false</FluidFlowMode>
          <DynamicMode Lock="Always">false</DynamicMode>
          <UplevelReference />
          <Default>FluidType.Composition</Default>
        </Variable>
        <Variable>
          <Name>ProductCarbon</Name>
          <Description>Product carbon molar flow</Description>
          <Type>Mole Flow</Type>
          <ProcessMode Lock="Always">false</ProcessMode>
          <FluidFlowMode Lock="Always">false</FluidFlowMode>
          <DynamicMode Lock="Always">false</DynamicMode>
          <TotalizedVariable />
        </Variable>
        <Variable>
          <Name>TotalProduct</Name>
          <Description>Product accumulated over a dynamic run</Description>
          <Type>Mass</Type>
          <Group>Economics</Group>
          <ProcessMode Lock="Always">true</ProcessMode>
          <FluidFlowMode Lock="Always">true</FluidFlowMode>
          <DynamicMode Lock="Always">false</DynamicMode>
          <Favorite />
          <TotalizedVariable />
          <Min>0</Min>
          <Max>0</Max>
          <Default>0</Default>
        </Variable>
        <Variable>
          <Name>TP</Name>
          <Description>Product total state value for integration calculation</Description>
          <Type>Mass</Type>
          <ProcessMode Lock="Always">true</ProcessMode>
          <FluidFlowMode Lock="Always">true</FluidFlowMode>
          <DynamicMode Lock="Always">false</DynamicMode>
          <Min>0</Min>
          <Max>0</Max>
          <Default>0</Default>
        </Variable>
        <Variable>
          <Name>dTPdt</Name>
          <Description>Product total state value time derivative</Description>
          <Type>Real</Type>
          <Default>0</Default>
        </Variable>
        <Variable>
          <Name>Var104</Name>
          <Type>Mass Flow</Type>
          <UplevelReference />
        </Variable>
      </Variables>
      <Equations>
        <Equation>
          <Name>Eqn1</Name>
          <Formula>ValuePerMass * Var104 = ValuePerVol * Q</Formula>
        </Equation>
        <Equation>
          <Name>Eqn2</Name>
          <Formula>ProductValue= Var104 * ValuePerMass</Formula>
        </Equation>
        <Equation>
          <Name>Eqn3</Name>
          <Formula>ProductCarbon = sum(F*z* FluidType.CNUM)</Formula>
        </Equation>
        <Equation>
          <Name>Eqn4</Name>
          <Condition>Dyn</Condition>
          <Formula>der(TP) = Var104</Formula>
        </Equation>
        <Equation>
          <Name>Eqn5</Name>
          <Condition>Dyn</Condition>
          <Formula>TotalProduct = TP</Formula>
        </Equation>
      </Equations>
      <Groups>
        <Group>
          <Name>Economics</Name>
          <Description>Operating expense and capital cost estimation</Description>
        </Group>
      </Groups>
      <GraphicData>
        <Icon>
          <DefaultIcon>Default</DefaultIcon>
          <Images>
            <Image>
              <Name>Default</Name>
              <Rendering>
                <Drawing Format="xaml">&lt;Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Stretch="Fill"&gt;
	&lt;Canvas Width="100.000" Height="100.000"&gt;
	  &lt;!-- Tank --&gt;
	  &lt;!-- Tank Body --&gt;
	  &lt;Path Stroke="Black" StrokeThickness="2.5" StrokeLineJoin="Round" Data="M 20,27 v 68 h 75 v -68"&gt;
      &lt;Path.Fill&gt;
        &lt;LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"&gt;
          &lt;GradientStop Color="#ff707070" Offset="0.0" /&gt;
          &lt;GradientStop Color="White" Offset="0.5" /&gt;
          &lt;GradientStop Color="#ff707070" Offset="1.0" /&gt;
        &lt;/LinearGradientBrush&gt;
      &lt;/Path.Fill&gt;
    &lt;/Path&gt;
    &lt;!-- Tank Dome --&gt;
	  &lt;Path Stroke="Black" StrokeThickness="2.5" StrokeLineJoin="Round" Data="M 20,27 h 75 a 38,22 0 0 0 -75,0 z"&gt;
      &lt;Path.Fill&gt;
        &lt;RadialGradientBrush  GradientOrigin="0.5,1" Center="0.5,1" RadiusX="0.5" RadiusY="1" &gt;
          &lt;GradientStop Color="White" Offset="0.0" /&gt;
          &lt;GradientStop Color="#ff707070" Offset="1.0" /&gt;
        &lt;/RadialGradientBrush&gt;
      &lt;/Path.Fill&gt;
    &lt;/Path&gt;
    &lt;!-- Incoming product arrow --&gt;
    &lt;Path StrokeThickness="2.5" Stroke="#ff000000" StrokeMiterLimit="0.5" Fill="Black" Data="M 0,50 h 40 v -10 l 15,20 l -15,20 v -10 h -40 z"/&gt;
		&lt;!-- Currency symbols --&gt;
    &lt;Ellipse Width="50" Height="50" Canvas.Right="-5" Canvas.Bottom="-5"&gt;
      &lt;Ellipse.Fill&gt;
        &lt;RadialGradientBrush  GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="1" RadiusY="1" &gt;
          &lt;GradientStop Color="White" Offset="0.0" /&gt;
          &lt;GradientStop Color="#ff707070" Offset="1.0" /&gt;
        &lt;/RadialGradientBrush&gt;
      &lt;/Ellipse.Fill&gt;
    &lt;/Ellipse&gt;
    &lt;TextBlock Width="20" Height="35" Canvas.Right="0" Canvas.Bottom="5" FontFamily="Arial" FontSize="35" FontWeight="SemiBold" Foreground="DarkGray" TextWrapping="Wrap"&gt;€&lt;/TextBlock&gt;
    &lt;TextBlock Width="20" Height="35" Canvas.Right="20" Canvas.Bottom="5" FontFamily="Arial" FontSize="35" FontWeight="SemiBold" Foreground="DarkGray" TextWrapping="Wrap"&gt;¥&lt;/TextBlock&gt;
    &lt;TextBlock Width="25" Height="40" Canvas.Right="5" Canvas.Bottom="2.5" FontFamily="Arial" FontSize="40" FontWeight="SemiBold" Foreground="Black" TextWrapping="Wrap"&gt;$&lt;/TextBlock&gt;
	&lt;/Canvas&gt;
&lt;/Viewbox&gt;</Drawing>
              </Rendering>
            </Image>
          </Images>
        </Icon>
      </GraphicData>
      <Help>
        <Content format="rtfzip"><![CDATA[]]></Content>
      </Help>
    </Model>
  </Library>
  <FlowSheet>
    <Name>Main</Name>
    <ShowConnectorLabel>false</ShowConnectorLabel>
    <ShowModelLabel>false</ShowModelLabel>
    <Parameters>
      <Parameter>
        <Name>Param1</Name>
        <Type>Real</Type>
      </Parameter>
      <Parameter>
        <Name>Param2</Name>
        <Type>Real</Type>
      </Parameter>
      <Parameter>
        <Name>Param3</Name>
        <Type>Real</Type>
      </Parameter>
    </Parameters>
    <Variables>
      <Variable>
        <Name>WasteWater</Name>
        <Type>Dimensionless</Type>
      </Variable>
      <Variable>
        <Name>c_ibpe</Name>
        <Type>Molar Density</Type>
      </Variable>
      <Variable>
