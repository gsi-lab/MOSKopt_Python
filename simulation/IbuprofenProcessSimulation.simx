    </Fluid>
    <Model>
      <Type>RXIBU_NRTL</Type>
      <Description>Precipitation of IBUPROFEN
IBUPROFEN(aq) &lt;--&gt; IBUPROFEN(s)
ln(xIBUP) = 0.28937 - 2606/T + 1.19778* ln(T) 
Reference: J. Chem. Eng. Data 2010, 55, 11, 5283–5285 (https://doi.org/10.1021/je100255z)</Description>
      <NamePrefix>R</NamePrefix>
      <NameStartingNumber>1</NameStartingNumber>
      <IsReplaceableModel />
      <Parameters>
        <Parameter>
          <Name>FluidType</Name>
          <Description>Ibuprofen_solubility fluid type</Description>
          <Type>FluidType</Type>
          <Default>Ibuprofen1</Default>
        </Parameter>
        <Parameter>
          <Name>Nrxn</Name>
          <Description>Ibuprofen_solubility  number of reactions in the system</Description>
          <Type>Integer</Type>
          <Default>1</Default>
          <Max>100</Max>
          <Min>1</Min>
        </Parameter>
        <Parameter>
          <Name>RxnRateBasis</Name>
          <Description>Ibuprofen_solubility  fluid equilibrium reaction rate basis.\n     Absolute: Reaction rates represent absolute molar rates of change. \n     Per Unit Feed: Reaction rates are normalized based on the feed flow \n         rate. Representing the molar change per unit feed, they become\n         independent of the absolute flow rate (preferred).\n\nBoth options yield identical results, but require different formulations\nin the reaction Rate model. “Per Unit Feed” is recommended due to\nbetter numerical stability when stream flows approach zero rate.\nStarting with v2023 fluid reactions are defaulted to the "Per Unit Feed"\noption.  The "Absolute" option is retained for compatibility with\nsimulations built before v2023 and will be removed in a future release.</Description>
          <Type>Enumeration</Type>
          <Default>Absolute</Default>
          <Values>
            <Value>Absolute</Value>
            <Value>Per Unit Feed</Value>
          </Values>
        </Parameter>
        <Parameter>
          <Name>Phase</Name>
          <Description>Ibuprofen_solubility Phase for reaction</Description>
          <Type>Enumeration</Type>
          <Default>Liquid</Default>
          <Values>
            <Value>Liquid</Value>
            <Value>Vapor</Value>
          </Values>
        </Parameter>
      </Parameters>
      <Conditions>
        <Condition>
          <Name>RxnRate</Name>
          <Expression>RxnRateBasis = "Absolute"</Expression>
        </Condition>
        <Condition>
          <Name>RxnRatePF</Name>
          <Expression>RxnRateBasis = "Per Unit Feed"</Expression>
        </Condition>
      </Conditions>
      <Connections>
        <Connection>
          <Name>Gamma1</Name>
          <Type>Variable</Type>
          <From>StateX.lngammal</From>
          <To>lngamma</To>
        </Connection>
      </Connections>
      <Variables>
        <Variable>
          <Name>T</Name>
          <Description>RXKCl_eNRTL equilibrium temperature</Description>
          <Type>Temperature</Type>
          <UplevelReference />
          <Min>FluidType.Tmin</Min>
          <Max>FluidType.Tmax</Max>
          <Default>FluidType.Temperature</Default>
        </Variable>
        <Variable>
          <Name>P</Name>
          <Description>RXKCl_eNRTL equilibrium pressure</Description>
          <Type>Pressure</Type>
          <UplevelReference />
          <Min>FluidType.Pmin</Min>
          <Max>FluidType.Pmax</Max>
          <Default>FluidType.Pressure</Default>
        </Variable>
        <Variable>
          <Name>C</Name>
          <Description>RXKCl_eNRTL molar bulk phase concentration</Description>
          <Type>Molar Concentration</Type>
        </Variable>
        <Variable>
          <Name>x</Name>
          <Description>RXKCl_eNRTL equilibrium composition</Description>
          <Type>Molar Composition</Type>
          <Dimension>FluidType.CompList</Dimension>
          <Default>FluidType.composition</Default>
        </Variable>
        <Variable>
          <Name>lnx</Name>
          <Description>RXKCl_eNRTL logarithmic equilibrium molar composition on a solid free basis</Description>
          <Type>Dimensionless</Type>
          <Dimension>FluidType.CompList</Dimension>
          <Min>-50</Min>
          <Max>1E-06</Max>
          <Default>-1</Default>
        </Variable>
        <Variable>
          <Name>lngamma</Name>
          <Description>RXKCl_eNRTL logarithmic liquid activity coefficients</Description>
          <Type>Real</Type>
          <Dimension>FluidType.CompList</Dimension>
          <Min>-50</Min>
          <Max>15</Max>
          <Default>0</Default>
        </Variable>
        <Variable>
          <Name>lnKsp</Name>
          <Description>RXKCl_eNRTL logarithmic equilibrium solubility product, mole fraction basis</Description>
          <Type>Real</Type>
          <Max>100</Max>
        </Variable>
        <Variable>
          <Name>lna</Name>
          <Description>RXKCl_eNRTL equilibrium logarithmic activity of species </Description>
          <Type>Dimensionless</Type>
          <Dimension>FluidType.CompList</Dimension>
        </Variable>
        <Variable>
          <Name>zsu</Name>
          <Description>RXKCl_eNRTL unbounded mole fraction of free solid</Description>
          <Type>Molar Composition</Type>
          <Min>-20</Min>
          <Default>0</Default>
        </Variable>
        <Variable>
          <Name>dz_rxn</Name>
          <Description>RXKCl_eNRTL composition change for reaction's base component</Description>
          <Condition>RxnRatePF</Condition>
          <Type>Reaction Rate per Unit Feed</Type>
          <Dimension>Nrxn</Dimension>
        </Variable>
        <Variable>
          <Name>dz</Name>
          <Description>RXKCl_eNRTL composition change for each component</Description>
          <Condition>RxnRatePF</Condition>
          <Type>Reaction Rate per Unit Feed</Type>
          <Dimension>FluidType.CompList</Dimension>
        </Variable>
        <Variable>
          <Name>dz_rxn</Name>
          <Description>RXKCl_eNRTL molar flowrate change for reaction's base component.\ndz_rxn (molar flow units) is retained for compatibility with simulations build before v2023 and will be removed in a future release.</Description>
          <Condition>RxnRate</Condition>
          <Type>Mole Flow</Type>
          <Dimension>Nrxn</Dimension>
          <Min>-1000000</Min>
          <Default>0</Default>
        </Variable>
        <Variable>
          <Name>dz</Name>
          <Description>RXKCl_eNRTL molar flowrate change for each component.\ndz (molar flow units) is retained for compatibility with simulations build before v2023 and will be removed in a future release.</Description>
          <Condition>RxnRate</Condition>
          <Type>Mole Flow</Type>
          <Dimension>FluidType.CompList</Dimension>
          <Min>-1000000</Min>
          <Default>0</Default>
        </Variable>
        <Variable>
          <Name>Rate</Name>
          <Description>RXKCl_eNRTL component reaction rates.\nRate is retained for compatibility with simulations built before v2023 and will be removed in a future release.</Description>
          <Condition>RxnRate</Condition>
          <Type>Mole Flow</Type>
          <Dimension>FluidType.CompList</Dimension>
          <Min>-1000000</Min>
          <Default>0</Default>
        </Variable>
        <Variable>
          <Name>Heat</Name>
          <Description>RXKCl_eNRTL reaction heat adjustment for the combined vapor and liquid phase reactions, normally zero as enthalpies include heat of formation)</Description>
          <Type>Heat Duty</Type>
          <ProcessMode />
          <FluidFlowMode />
          <DynamicMode />
        </Variable>
      </Variables>
      <Equations>
        <Equation>
          <Name>LnX1</Name>
          <Formula>exp(lnx) = StateX.xSF + 1E-10 </Formula>
        </Equation>
        <Equation>
          <Name>activity_1</Name>
          <Formula>lna = lnx + lngamma</Formula>
        </Equation>
        <Equation>
          <Name>Ksp1</Name>
          <Description>Solubility product</Description>
          <Formula>lnKsp = 0.289367 -2605.96 / T +1.19778 * ln(T) </Formula>
        </Equation>
        <Equation>
          <Name>Ksp2</Name>
          <Formula>lnKsp = lna["IBU"] + (exp(- min(zsu, 0)) - 1)</Formula>
        </Equation>
        <Equation>
          <Name>xIBU-XTAL</Name>
          <Formula>x["IBU"] = max(zsu, 0)</Formula>
        </Equation>
        <Equation>
          <Name>dz_IBU-XTAL</Name>
          <Description>RXIBU-XTAL_ NRTL change for IBUPROFEN (s)</Description>
          <Formula>dz["IBU-XTAL"] =  dz_rxn[1]</Formula>
        </Equation>
        <Equation>
          <Name>dz_ETHANOL</Name>
          <Description>RXIBU-XTAL_NRTL change for ETHANOL</Description>
          <Formula>dz["ETHANOL"] = 0</Formula>
        </Equation>
        <Equation>
          <Name>dz_IBU</Name>
          <Description>RXIBU-XTAL_NRTL change for IBUPROFEN (aq)</Description>
          <Formula>dz["IBU"] =  - dz_rxn[1]</Formula>
        </Equation>
        <Equation>
          <Name>Ratedz</Name>
          <Description>This equations is retained for compatibility with simulations built before v2023 and will be removed in a future release.</Description>
          <Condition>RxnRate</Condition>
          <Formula>Rate = dz</Formula>
        </Equation>
        <Equation>
          <Name>dz_IBAP</Name>
          <Formula>dz["IBAP"]=0</Formula>
        </Equation>
        <Equation>
          <Name>dz_IBPE</Name>
          <Formula>dz["IBPE"]=0</Formula>
        </Equation>
        <Equation>
          <Name>dz_IBEB</Name>
          <Formula>dz["IBEB"]=0</Formula>
        </Equation>
        <Equation>
          <Name>dz_WATER</Name>
          <Formula>dz["WATER"]=0</Formula>
        </Equation>
        <Equation>
          <Name>dz_DECANE</Name>
          <Formula>dz["DECANE"]=0</Formula>
        </Equation>
        <Equation>
          <Name>dz_CO</Name>
          <Formula>dz["CO"]=0</Formula>
        </Equation>
        <Equation>
          <Name>dz_MEK</Name>
          <Formula>dz["MEK"]=0</Formula>
        </Equation>
        <Equation>
          <Name>dz_IBS</Name>
          <Formula>dz["IBS"]=0</Formula>
        </Equation>
        <Equation>
          <Name>dz_IBPCl</Name>
          <Formula>dz["IBPCl"]=0</Formula>
        </Equation>
        <Equation>
          <Name>dz_3-IPPA</Name>
          <Formula>dz["3-IPPA"]=0</Formula>
        </Equation>
        <Equation>
          <Name>dz_OLIG</Name>
          <Formula>dz["OLIG"]=0</Formula>
        </Equation>
        <Equation>
          <Name>dz_EOAC</Name>
          <Formula>dz["EOAC"]=0</Formula>
        </Equation>
        <Equation>
          <Name>dz_HCl</Name>
          <Formula>dz["HCl"]=0</Formula>
        </Equation>
        <Equation>
          <Name>dz_H2</Name>
          <Formula>dz["H2"]=0</Formula>
        </Equation>
      </Equations>
