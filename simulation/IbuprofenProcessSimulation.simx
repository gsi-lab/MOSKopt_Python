          <Type>Currency / Time</Type>
          <Group>Summary</Group>
          <Favorite />
        </Variable>
        <Variable>
          <Name>TotalRawMatlCost</Name>
          <Description>Summary total raw material costs</Description>
          <Type>Currency / Time</Type>
          <Group>Summary</Group>
          <Favorite />
        </Variable>
        <Variable>
          <Name>TotalWasteCost</Name>
          <Description>Summary total waste costs</Description>
          <Type>Currency / Time</Type>
