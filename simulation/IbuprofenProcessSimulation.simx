        <Variable>
          <Name>CO2eEmission</Name>
          <Description>Global CO2e emissions price (either through a direct carbon tax or purchased carbon credit)</Description>
          <Type>Currency / Mass</Type>
          <Group>Global Utility Prices</Group>
          <ProcessMode Lock="Always">true</ProcessMode>
          <FluidFlowMode Lock="Always">true</FluidFlowMode>
          <DynamicMode Lock="Always">true</DynamicMode>
          <Favorite />
