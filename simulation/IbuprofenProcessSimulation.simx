    &lt;TextBlock  Width="30" Height="55" Canvas.Left="40" Canvas.Top="50" TextAlignment="Center" FontFamily="Arial" FontSize="35" FontStyle="normal" FontWeight="SemiBold" Foreground="DarkGray" TextWrapping="Wrap"&gt;¥&lt;/TextBlock&gt;
