          <Default>4.65989</Default>
        </Variable>
        <Variable>
          <Name>PlantAir</Name>
          <Description>Global plant air (compressed and dried) utility price</Description>
          <Type>Currency / Volume</Type>
          <Group>Global Utility Prices</Group>
          <ProcessMode Lock="Always">true</ProcessMode>
          <FluidFlowMode Lock="Always">true</FluidFlowMode>
          <DynamicMode Lock="Always">true</DynamicMode>
          <Favorite />
          <Global />
          <Default>0.03136</Default>
