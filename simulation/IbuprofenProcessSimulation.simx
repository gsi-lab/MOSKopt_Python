          <Group>Operation</Group>
          <Favorite />
          <Default>1</Default>
        </Variable>
        <Variable>
          <Name>F</Name>
          <Description>Source molar or gas standard volumetric flow (before reaction)</Description>
          <Type>Mole Flow</Type>
          <Group>Operation</Group>
          <Favorite />
          <Min>-1000000</Min>
          <Default>1</Default>
        </Variable>
        <Variable>
          <Name>Q</Name>
